<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            #232: measure test-code coverage too, not just src. Phase 1 scope
            is unit tests only (see the issue's 2026-08-14 scope decision).
            AotSmoke is deliberately uninstrumented (a runnable smoke
            consumer, not a test suite), and the specialty suites
            (Concurrency, Fuzz, Integration, Schema.Integration, Smoke) are
            deferred to a later phase.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <ExcludeByFile>**/bin/**/*.cs;**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!--
            Compiler-emitted polyfill: `required` modifier on net6/netstandard
            synthesises this attribute under System.Runtime.CompilerServices.
            It's never executed; without exclusion it shows up at 0% and trips
            the 90% gate. See https://github.com/dotnet/runtime/issues/91398.

            AutoGeneratedProgram: the SDK's top-level-statements entry point
            (Microsoft.NET.Test.Sdk.Program.cs), a permanent 1-line gap in
            every test assembly. ExcludeByFile doesn't match its absolute
            NuGet-cache path, so exclude by type name instead (#232).
          -->
          <Exclude>[*]System.Runtime.CompilerServices.CompilerFeatureRequiredAttribute,[*]System.Runtime.CompilerServices.RequiredMemberAttribute,[*]System.Runtime.CompilerServices.IsExternalInit,[*]AutoGeneratedProgram</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
