<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wolfgang.AuditTrail.Example.AdventureWorks</RootNamespace>
    <AssemblyName>Wolfgang.AuditTrail.Example.AdventureWorks</AssemblyName>
    <NoWarn>$(NoWarn);CA1515;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore\Wolfgang.AuditTrail.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <!--
      Microsoft.Data.SqlClient (via the SQL Server provider) brings
      System.Security.Cryptography.Pkcs 9.0.x, which carries the
      CVE-2026-70162 / CVE-2026-84008 advisories and trips NU1902/NU1903
      (warning as error). Same override as the integration-test projects.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
