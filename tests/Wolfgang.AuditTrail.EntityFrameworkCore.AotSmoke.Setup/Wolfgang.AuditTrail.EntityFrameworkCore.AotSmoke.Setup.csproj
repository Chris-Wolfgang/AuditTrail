<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wolfgang.AuditTrail.AotSmoke</RootNamespace>
    <AssemblyName>Wolfgang.AuditTrail.EntityFrameworkCore.AotSmoke.Setup</AssemblyName>

    <!--
      DELIBERATELY NOT PublishAot. This is the design-time host `dotnet ef
      dbcontext optimize` uses (as the startup project, with the sibling
      AotSmoke.Model project as the context-owning project) to generate the
      compiled model consumed by AotSmoke (#53). It also performs the two
      operations EF
      Core's compiled models explicitly do NOT support: runtime schema
      creation (EnsureCreatedAsync) and the migrations-diff pipeline
      (MigrateAuditSchemaAsync) — both need the full, uncompiled runtime
      model. Setting PublishAot=true on a project (even without ever
      publishing it) bakes an "IsNativeAot" feature switch into its
      runtimeconfig.json that EF Core checks on first DbContext use, which
      would break `dotnet ef` itself (chicken-and-egg) and these two
      operations.
    -->

    <!--
      Example/demo-style code: relax the strict-library analyzers that don't
      apply to a runnable smoke consumer.
    -->
    <NoWarn>$(NoWarn);CA1515;CA1812;MA0004;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Everything EF-shaped (AppDbContext, Product, the design-time factory)
      lives in AotSmoke.Model — a plain Library, not another Exe — so AotSmoke
      never needs to reference an Exe project directly (Native AOT publish is
      always self-contained, and the SDK rejects a self-contained executable
      referencing a non-self-contained one, NETSDK1150).
    -->
    <ProjectReference Include="..\Wolfgang.AuditTrail.EntityFrameworkCore.AotSmoke.Model\Wolfgang.AuditTrail.EntityFrameworkCore.AotSmoke.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      dotnet-ef requires Microsoft.EntityFrameworkCore.Design on the STARTUP
      project specifically, not just on the project that owns the DbContext
      — Model having it isn't enough. Same NU1903 transitive-vulnerability
      pin as Model (see that csproj for details).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
