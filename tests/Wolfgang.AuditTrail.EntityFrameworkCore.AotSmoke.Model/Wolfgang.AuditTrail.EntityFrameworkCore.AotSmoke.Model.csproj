<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wolfgang.AuditTrail.AotSmoke</RootNamespace>
    <AssemblyName>Wolfgang.AuditTrail.EntityFrameworkCore.AotSmoke.Model</AssemblyName>

    <!--
      A plain class library, DELIBERATELY not an Exe. AppDbContext/Product/
      StaticAuditUserProvider (and dotnet-ef's design-time factory) live here
      so both the .Setup project (non-AOT design-time host) and the AotSmoke
      project (Native-AOT-published) can reference the same types via a
      Library ProjectReference. AotSmoke can't reference .Setup directly —
      Native AOT publish is always self-contained, and the SDK rejects a
      self-contained executable referencing a non-self-contained executable
      (NETSDK1150) — but referencing a Library carries no such restriction.
      `dotnet ef dbcontext optimize` also targets this project directly (with
      .Setup as the startup project), generating the compiled model here so
      it ships alongside AppDbContext itself.

      Example/demo-style code: relax the strict-library analyzers that don't
      apply to a runnable smoke consumer.
    -->
    <NoWarn>$(NoWarn);CA1515;CA1812;MA0004;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore\Wolfgang.AuditTrail.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Pin the SQLite native bundle to a version without GHSA-2m69-gcr7-jv3q.
      Matches the pin in examples/Wolfgang.AuditTrail.EntityFrameworkCore.Example.Console.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!--
      Microsoft.EntityFrameworkCore.Design 10.0.0 pulls System.Security.Cryptography.Xml
      9.0.0 transitively, which trips NU1903 (multiple GHSA advisories, warning
      as error). Override to the current patched 10.x line.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
