<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 is the floor because AuditSchemaMigrator itself is net8.0+ (EF Core
      7+ design-time model requirement). Multi-targeted for the same reason
      Wolfgang.AuditTrail.EntityFrameworkCore.Tests.Integration is: the providers
      split across two EF Core majors. Pomelo caps at EF Core 9 (forcing it onto
      10 throws MissingMethodException, probed in the sibling project), while
      SQL Server and PostgreSQL are carried here on their EF Core 10 packages.
      Each provider's fixture and test file is TFM-scoped below via Compile
      Remove, so the net8.0 build sees only MySQL and the net10.0 build only
      SQL Server + PostgreSQL. SQLite is covered by
      Wolfgang.AuditTrail.EntityFrameworkCore.Tests.Unit.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Needs Linux containers (Testcontainers). Marker for workflows that run container-backed suites only on Linux runners; nothing reads it until that workflow change is synced. -->
    <RequiresLinuxContainers>true</RequiresLinuxContainers>
    <!--
      Mirrors Wolfgang.AuditTrail.EntityFrameworkCore.Tests.Integration: default to a no-op so
      pr.yaml's blanket `dotnet test` doesn't try to spin Docker on a runner
      without it. The integration.yaml workflow sets RunIntegrationTests=true.
    -->
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="'$(RunIntegrationTests)' == 'true'">true</IsTestProject>
    <NoWarn>$(NoWarn);VSTHRD200;CA1707;S6966;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore\Wolfgang.AuditTrail.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <!--
    Frozen schema-version-1 install scripts, one per provider, captured from
    AuditSchemaMigrator.RunAsync(dryRun: true) while the library still installed
    version 1. They are the baseline every future "upgrade from v1" test starts
    from, and must never be regenerated: see FrozenInstallScripts.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\V1\*.sql" LogicalName="V1.%(Filename).sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

  </ItemGroup>

  <!--
    EF Core 9 provider: MySQL via Pomelo. Kept on its own TFM slot because
    Pomelo has no EF Core 10 build.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />

    <Compile Remove="SqlServerAuditSchemaMigratorTests.cs" />
    <Compile Remove="PostgresAuditSchemaMigratorTests.cs" />
    <Compile Remove="TestSupport\SqlServerSchemaFixture.cs" />
    <Compile Remove="TestSupport\PostgresSchemaFixture.cs" />
  </ItemGroup>

  <!-- EF Core 10 providers: SQL Server, PostgreSQL. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!--
      Microsoft.Data.SqlClient pulls System.Security.Cryptography.Pkcs from the
      9.0.x line transitively, and versions up to 9.0.20 carry the CVE-2026-70162
      and CVE-2026-84008 denial-of-service advisories, which trip NU1902/NU1903
      (warning as error). Override to the patched 9.0.x release. Drop this once a
      SqlClient release depends on 9.0.21 or later directly.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Npgsql" Version="10.0.3" />

    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />

    <Compile Remove="MySqlAuditSchemaMigratorTests.cs" />
    <Compile Remove="TestSupport\MySqlSchemaFixture.cs" />
  </ItemGroup>

</Project>
