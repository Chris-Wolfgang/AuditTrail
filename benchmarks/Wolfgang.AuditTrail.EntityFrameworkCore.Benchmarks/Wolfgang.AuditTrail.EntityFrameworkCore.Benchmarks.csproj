<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net8.0 added alongside net10.0 solely so MySQL (Pomelo.EntityFrameworkCore.MySql,
      still capped at EF Core 9 as of this writing) can join ProviderSaveChangesBenchmarks.
      The PR regression gate compares each provider's own numbers between two commits on
      the SAME TFM, never across providers, so MySQL running on a different TFM than
      SqlServer/PostgreSQL doesn't affect comparability, see issue #272. Remove the
      net8.0 slot once Pomelo ships an EF Core 10 stable and MySQL can rejoin the
      net10.0-only matrix.
    -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- CA1001 suppressed because BDN owns disposable lifecycle via [GlobalSetup]/[GlobalCleanup]. -->
    <!-- MA0048 (file-name == type-name) suppressed: benchmark entities are
         co-located in BenchmarkEntities.cs for navigability. -->
    <NoWarn>$(NoWarn);MA0004;VSTHRD200;S6966;CA1515;CA1001;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore\Wolfgang.AuditTrail.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- EF Core 10-only providers: Sqlite, SqlServer, PostgreSQL. Microsoft's own
       EF Core 10 relational packages are net10.0-only builds, same pattern as
       the third-party Oracle/Db2 providers found in #273/#274. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore.Npgsql\Wolfgang.AuditTrail.EntityFrameworkCore.Npgsql.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- NU1903 transitive override — see issue #121. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <!--
    EF Core 9-capped provider: MySQL (Pomelo). See #272. SaveChangesBenchmarks
    (the SQLite-only, non-provider-parametrized class) has nothing to do with
    MySQL and stays net10.0-only; excluded here rather than duplicating the
    Sqlite package reference onto a TFM that doesn't need it.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.14.0" />

    <Compile Remove="SaveChangesBenchmarks.cs" />
  </ItemGroup>

</Project>
