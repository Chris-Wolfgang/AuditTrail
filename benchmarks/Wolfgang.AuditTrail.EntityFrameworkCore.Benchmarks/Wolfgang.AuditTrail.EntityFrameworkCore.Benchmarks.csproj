<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- CA1001 suppressed because BDN owns disposable lifecycle via [GlobalSetup]/[GlobalCleanup]. -->
    <!-- MA0048 (file-name == type-name) suppressed: benchmark entities are
         co-located in BenchmarkEntities.cs for navigability. -->
    <NoWarn>$(NoWarn);MA0004;VSTHRD200;S6966;CA1515;CA1001;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore\Wolfgang.AuditTrail.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Wolfgang.AuditTrail.EntityFrameworkCore.Npgsql\Wolfgang.AuditTrail.EntityFrameworkCore.Npgsql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- NU1903 transitive override — see issue #121. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
    <PackageReference Include="Testcontainers.Oracle" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Db2" Version="4.14.0" />
  </ItemGroup>

  <!--
    IBM.EntityFrameworkCore bundles a Windows-only native Db2 CLI driver;
    the Linux build needs the separately-published -lnx package instead.
    See Tests.Integration's csproj for the full rationale.
  -->
  <ItemGroup>
    <PackageReference Include="IBM.EntityFrameworkCore" Version="10.0.0.100" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="IBM.EntityFrameworkCore-lnx" Version="10.0.0.100" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
